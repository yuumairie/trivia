# Copy this file to .env and adjust as needed. .env itself is gitignored
# since it can hold real credentials (e.g. a production DB password).

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# DJANGO_SECRET_KEY=change-me-to-a-random-secret-in-production
# DJANGO_CORS_ALLOW_ALL=False

# docker-compose.ymlのdbサービス(ローカルMySQLコンテナ)に繋ぐ。
# 本番相当(例: RDSなど外部のMySQL)の場合は、下記を実際のホスト・認証情報に
# 置き換えてください。
DB_NAME=trivia
DB_USER=trivia
DB_PASSWORD=trivia
DB_HOST=db
DB_PORT=3306

VUE_APP_API_BASE_URL=http://localhost:8000
